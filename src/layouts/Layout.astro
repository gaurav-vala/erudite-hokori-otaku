---
import '@/styles/global.css'
import '@/styles/typography.css'

import Footer from '@/components/Footer.astro'
import Head from '@/components/Head.astro'
import Header from '@/components/Header.astro'
import { SITE } from '@/consts'
import { cn } from '@/lib/utils'

interface Props {
  title?: string
  description?: string
  image?: string
  isWide?: boolean
}

const { title, description, image, isWide = false } = Astro.props
const hasHeadSlot = Astro.slots.has('head')
---

<!doctype html>
<html lang={SITE.locale}>
  <Head
    title={title}
    description={description}
    image={image}
    hasHeadSlot={hasHeadSlot}
  >
    <slot name="head" />
  </Head>
  <body>
    <div class="flex h-fit min-h-screen flex-col gap-y-6 font-sans">
      <Header />
      <main class="grow">
        <div
          class={cn(
            'mx-auto flex grow flex-col gap-y-6 px-4',
            !isWide && 'max-w-4xl'
          )}
        >
          <slot />
        </div>
      </main>
      <Footer />
    </div>
  </body>
</html>
